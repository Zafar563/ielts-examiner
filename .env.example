# Telegram Bot Configuration (Get token from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ielts_bot
DB_SSLMODE=disable

# LLM Configuration
# LLM_PROVIDER can be "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here

# Models:
# For Gemini: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# For OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=gemini-1.5-flash

# Optional: custom base URL for OpenAI-compatible proxies
# LLM_BASE_URL=https://api.openai.com/v1
